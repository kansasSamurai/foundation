<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>org.jwellman</groupId>
    <artifactId>foundation-parent</artifactId>
    <version>1.0.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Foundation Framework Parent</name>
    <description>Parent POM for Foundation micro-framework tiered artifacts</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <modules>
        <module>research</module>
        <module>stone</module>
        <module>bronze</module>
        <module>bronze-demos</module>
        <module>silver</module>
        <module>silver-demos</module>
        <module>gold</module>
        <module>platinum</module>
    </modules>

    <!--
        Since Stone is the least common denominator and has ZERO dependencies,
        this section is empty.  Higher tiers DO have dependencies kept in
        their individual project pom.  
        
        See the <dependencyManagement> section for versioning information.
    -->
    <dependencies>

        <!-- These look and feels were originally used for project
             prototyping but have been removed as explicit dependencies for
             the following reasons:
             1) To keep the distribution .jar's as lean as possible, external
                look and feels are not distributed WITH the Foundation API.
             2) Some LAFs are licensed as GPL and are thus not eligible to
                be delivered directly with the Foundation API.


        <!dashdash This is for napkinlaf; may have to rollback to 1.0 dashdash>
        <dependency>
            <groupId>org.jdom</groupId>
            <artifactId>jdom</artifactId>
            <version>1.1</version>
        </dependency>

        <!dashdash This is not in maven central dashdash>
        <dependency>
            <groupId>net.sourceforge.napkinlaf</groupId>
            <artifactId>napkinlaf</artifactId>
            <version>1.2</version>
        </dependency>

        <dependency>
            <groupId>com.mgarin</groupId>
            <artifactId>weblaf</artifactId>
            <version>1.27</version>
        </dependency>

        <!dashdash  1.29 is my version with a fix; use if available
        <dependency>
            <groupId>com.mgarin</groupId>
            <artifactId>weblaf</artifactId>
            <version>1.29</version>
        </dependency>
        dashdash>

        <!dashdash This is currently only necessary for weblaf (though I may keep) dashdash>
        <dependency>
            <groupId>com.thoughtworks.xstream</groupId>
            <artifactId>xstream</artifactId>
            <version>1.4.7</version>
        </dependency>

        <!dashdash Not available in maven central; see local repo dashdash>
        <dependency>
            <groupId>com.nilo.plaf</groupId>
            <artifactId>nimrod</artifactId>
            <version>1.2d</version>
        </dependency>

        <dependency>
            <groupId>com.jtattoo</groupId>
            <artifactId>JTattoo</artifactId>
            <version>1.6.11</version>
        </dependency>

         -->

    </dependencies>

    <dependencyManagement>

        <dependencies>

            <!-- Bronze and above -->
            <!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-api -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
            </dependency>

            <!-- SLF4J Simple implementation for demos -->
            <!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-simple -->
            <dependency>
                <groupId>
                    org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>2.0.17</version>
            </dependency>

            <!-- JSON processing -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.13.5</version>
            </dependency>

            <!-- Window Manager and Console -->
            <dependency>
                <groupId>gr.zeus</groupId>
                <artifactId>core</artifactId>
                <version>8.0.0-SNAPSHOT</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

</project>
