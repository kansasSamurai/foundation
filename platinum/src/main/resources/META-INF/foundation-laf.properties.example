# Example metadata file for Look and Feel JARs
# Place this file at META-INF/foundation-laf.properties in your LAF JAR
#
# This file helps Foundation discover and identify your Look and Feel.
# If this file is not present, Foundation will scan the JAR for classes
# extending javax.swing.LookAndFeel (which is slower).

# Required: Fully qualified class name of the LookAndFeel
laf.class=com.example.MyLookAndFeel

# Optional: Display name (defaults to class name if not specified)
laf.name=My Beautiful Look and Feel

# Optional: Description shown to users
laf.description=A modern, beautiful look and feel for Swing applications

# Optional: Version information
laf.version=1.0.0

# Optional: Author/vendor
laf.author=Your Name or Company
