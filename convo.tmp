3. Discovery and Registration Flow:

java
public class PluginDiscoveryService {
    
    private final File pluginsDir;
    private final PluginRegistry registry;
    
    public List<UnregisteredPlugin> scanForNewPlugins() {
        List<UnregisteredPlugin> discovered = new ArrayList<>();
        
        File[] pluginDirs = pluginsDir.listFiles(File::isDirectory);
        if (pluginDirs == null) return discovered;
        
        for (File pluginDir : pluginDirs) {
            String pluginId = pluginDir.getName();
            
            // Check if already registered
            if (registry.isRegistered(pluginId)) {
                continue;
            }
            
            // Try to discover plugin
            UnregisteredPlugin plugin = discoverPlugin(pluginDir);
            if (plugin != null) {
                discovered.add(plugin);
            }
        }
        
        return discovered;
    }
    
    private UnregisteredPlugin discoverPlugin(File pluginDir) {
        // Strategy 1: Look for plugin.properties descriptor
        File descriptor = new File(pluginDir, "plugin.properties");
        if (descriptor.exists()) {
            return loadFromDescriptor(pluginDir, descriptor);
        }
        
        // Strategy 2: Look for single JAR file
        File[] jars = pluginDir.listFiles((dir, name) -> 
            name.endsWith(".jar"));
        if (jars != null && jars.length == 1) {
            return discoverFromJar(pluginDir, jars[0]);
        }
        
        // Strategy 3: Look for manifest or convention
        // ...
        
        return null;
    }
    
    private UnregisteredPlugin loadFromDescriptor(
            File pluginDir, File descriptor) {
        try {
            Properties props = new Properties();
            props.load(new FileInputStream(descriptor));
            
            return new UnregisteredPlugin(
                pluginDir.getName(),
                props.getProperty("name"),
                props.getProperty("version"),
                props.getProperty("description"),
                pluginDir,
                props
            );
        } catch (IOException e) {
            return null;
        }
    }
    
    private UnregisteredPlugin discoverFromJar(
            File pluginDir, File jarFile) {
        try {
            JarFile jar = new JarFile(jarFile);
            Manifest manifest = jar.getManifest();
            
            if (manifest != null) {
                Attributes attrs = manifest.getMainAttributes();
                String mainClass = attrs.getValue("Main-Class");
                
                if (mainClass != null) {
                    // Create minimal properties from JAR
                    Properties props = new Properties();
                    props.setProperty("jar", jarFile.getName());
                    props.setProperty("mainClass", mainClass);
                    props.setProperty("name", 
                        attrs.getValue("Implementation-Title") 
                        != null ? attrs.getValue("Implementation-Title") 
                        : jarFile.getName());
                    
                    return new UnregisteredPlugin(
                        pluginDir.getName(),
                        props.getProperty("name"),
                        attrs.getValue("Implementation-Version"),
                        null,
                        pluginDir,
                        props
                    );
                }
            }
            jar.close();
        } catch (IOException e) {
            // Ignore
        }
        
        return null;
    }
}
4. Registration UI/Wizard:

java
public class PluginRegistrationWizard {
    
    public void showWizard(UnregisteredPlugin plugin) {
        // Step 1: Show discovered information
        JDialog dialog = new JDialog();
        dialog.setTitle("Register New Plugin");
        
        JPanel panel = new JPanel(new BorderLayout());
        
        // Show what was discovered
        JTextArea info = new JTextArea();
        info.setText(
            "Discovered Plugin:\\n" +
            "Name: " + plugin.getName() + "\\n" +
            "Version: " + plugin.getVersion() + "\\n" +
            "Location: " + plugin.getPluginDir() + "\\n\\n" +
            "Would you like to register this plugin?"
        );
        info.setEditable(false);
        panel.add(new JScrollPane(info), BorderLayout.CENTER);
        
        // Configuration options
        JPanel configPanel = new JPanel(new GridLayout(0, 2));
        
        JComboBox<LaunchMode> launchMode = new JComboBox<>(
            LaunchMode.values());
        configPanel.add(new JLabel("Launch Mode:"));
        configPanel.add(launchMode);
        
        JCheckBox enabled = new JCheckBox("Enable plugin", true);
        configPanel.add(new JLabel("Status:"));
        configPanel.add(enabled);
        
        panel.add(configPanel, BorderLayout.SOUTH);
        
        // Buttons
        JPanel buttons = new JPanel();
        JButton register = new JButton("Register");
        register.addActionListener(e -> {
            registerPlugin(plugin, launchMode.getItemAt(
                launchMode.getSelectedIndex()), enabled.isSelected());
            dialog.dispose();
        });
        
        JButton cancel = new JButton("Cancel");
        cancel.addActionListener(e -> dialog.dispose());
        
        buttons.add(register);
        buttons.add(cancel);
        panel.add(buttons, BorderLayout.NORTH);
        
        dialog.add(panel);
        dialog.pack();
        dialog.setLocationRelativeTo(null);
        dialog.setVisible(true);
    }
    
    private void registerPlugin(UnregisteredPlugin plugin, 
                                LaunchMode mode, boolean enabled) {
        PluginRegistration registration = new PluginRegistration(
            plugin.getId(),
            plugin.getName(),
            plugin.getPluginDir(),
            mode,
            enabled
        );
        
        registry.register(registration);
        registry.save();
    }
}
5. Complete Plugin Manager:

java
public class PluginManager {
    
    private final PluginRegistry registry;
    private final PluginDiscoveryService discovery;
    private final Map<String, LoadedPlugin> loadedPlugins;
    
    public PluginManager(File configDir, File pluginsDir) {
        this.registry = new PluginRegistry(
            new File(configDir, "registry.json"));
        this.discovery = new PluginDiscoveryService(
            pluginsDir, registry);
        this.loadedPlugins = new HashMap<>();
    }
    
    public void initialize() {
        // Load registry
        registry.load();
        
        // Discover new plugins
        List<UnregisteredPlugin> newPlugins = 
            discovery.scanForNewPlugins();
        
        if (!newPlugins.isEmpty()) {
            // Show UI to register new plugins
            for (UnregisteredPlugin plugin : newPlugins) {
                PluginRegistrationWizard wizard = 
                    new PluginRegistrationWizard();
                wizard.showWizard(plugin);
            }
        }
    }
    
    public LoadedPlugin launchPlugin(String pluginId) 
            throws Exception {
        PluginRegistration reg = registry.getPlugin(pluginId);
        if (reg == null || !reg.isEnabled()) {
            throw new IllegalStateException(
                "Plugin not registered or disabled");
        }
        
        PluginDescriptor descriptor = 
            PluginDescriptor.load(reg.getPluginDir());
        
        PluginLauncher launcher = new PluginLauncher();
        LoadedPlugin loaded = launcher.launch(
            descriptor, reg.getLaunchMode());
        
        loadedPlugins.put(pluginId, loaded);
        return loaded;
    }
    
    public List<PluginRegistration> getRegisteredPlugins() {
        return registry.getAllPlugins();
    }
}
